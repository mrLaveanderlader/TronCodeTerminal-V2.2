# Due to the changes of adding new colors and the ability to blend we use the function RENDER now
render() { 
        local x=$2 cy=$(( $1 / 2 ))
        local t=${col["$(( cy * 2 )),$x"]} b=${col["$(( cy * 2 + 1 )),$x"]}
        printf '\e[%d;%dH' $(( cy + 1 )) $(( x + 1 ))
        if [[ -n $t && -n $b ]]; then
            printf '\e[38;2;%sm\e[48;2;%sm▀\e[0m' "$t" "$b"
        elif [[ -n $t ]]; then
            printf '\e[38;2;%sm▀\e[0m' "$t"
        else
            printf '\e[38;2;%sm▄\e[0m' "$b"
        fi
}
 
# Does the averaging 50/50 style of the two colors and returns the new color as the MIX variable.
mix() {
    local IFS=';'
    local -a a=($1) b=($2)
    MIX="$(( (a[0] + b[0]) / 2 ));$(( (a[1] + b[1]) / 2 ));$(( (a[2] + b[2]) / 2 ))"
}
 
# Free only works if the cell is on the screen and nobody has a trail at the point.
free() {
    (( $1 >= 0 && $1 < PH && $2 >= 0 && $2 < PW )) && [[ -z ${wall["$1,$2"]} ]]
}
 
 
